# Zugangsschutz für die Web-Oberfläche (HTTP Basic Auth). Leer lassen = kein Schutz.
PV_USER=admin
PV_PASSWORD=bitte-aendern

# Fester Schlüssel für Formular-Token (optional; sonst nach jedem Neustart neu)
PV_SECRET=

# Google Cloud: API-Key aus einem Projekt mit aktivierter "Cloud Billing API".
# Ohne Key wird Google beim Abruf übersprungen.
GCP_API_KEY=

# Hetzner Cloud: API-Token mit Leserechten (Projekt -> Sicherheit -> API-Tokens). Ohne Token wird Hetzner übersprungen.
HCLOUD_TOKEN=
# Scaleway: optional, die Produktkatalog-API ist auch ohne Schlüssel erreichbar
SCW_SECRET_KEY=

# Sprache der Oberfläche erzwingen (de/en); leer = config.toml bzw. Umschalter
PV_LANG=

# Pfad hinter einem Reverse-Proxy, z. B. /preise/  (Standard: /)
PV_BASE_PATH=/
# Öffentliche Basis-URL für Links in Benachrichtigungen, z. B. https://preise.example.com
PV_BASE_URL=

# Benachrichtigungen (zusätzlich in config.toml [benachrichtigung] aktiv = true setzen)
PV_WEBHOOK_URL=
PV_SMTP_HOST=
PV_SMTP_PORT=587
PV_SMTP_USER=
PV_SMTP_PASSWORD=
PV_MAIL_FROM=preisverwaltung@example.com
PV_MAIL_TO=
